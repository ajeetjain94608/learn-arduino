{
  "cc1plus": [
    "-quiet",
    "-I",
    "{CORE}/cores/arduino",
    "-I",
    "{CORE}/variants/standard",
    "-imultilib",
    "avr5",
    "-iprefix",
    "{SYSROOT}/lib/gcc/avr/7.3.0/",
    "-D__AVR_ATmega328P__",
    "-D__AVR_DEVICE_NAME__=atmega328p",
    "-D",
    "F_CPU=16000000L",
    "-D",
    "ARDUINO=10819",
    "-D",
    "ARDUINO_AVR_UNO",
    "-D",
    "ARDUINO_ARCH_AVR",
    "{IN}",
    "-mn-flash=1",
    "-mno-skip-bug",
    "-quiet",
    "-dumpbase",
    "{IN}",
    "-mmcu=avr5",
    "-auxbase-strip",
    "OUT.o",
    "-g",
    "-Os",
    "-Wno-error=narrowing",
    "-std=gnu++11",
    "-fpermissive",
    "-fno-exceptions",
    "-ffunction-sections",
    "-fdata-sections",
    "-fno-threadsafe-statics",
    "-mn-flash=1",
    "-mno-skip-bug",
    "-fno-rtti",
    "-fno-enforce-eh-specs",
    "-fno-exceptions",
    "-o",
    "{OUT}"
  ],
  "as": [
    "-mmcu=avr5",
    "-mno-skip-bug",
    "-o",
    "{OUT}",
    "{IN}"
  ],
  "ld": [
    "-mavr5",
    "-Tdata",
    "0x800100",
    "-o",
    "{OUT}",
    "{SYSROOT}/avr/lib/avr5/crtatmega328p.o",
    "-L{SYSROOT}/lib/gcc/avr/7.3.0/avr5",
    "-L{SYSROOT}/avr/lib/avr5",
    "-L{SYSROOT}/lib/gcc/avr/7.3.0",
    "-L{SYSROOT}/lib/gcc",
    "-L{SYSROOT}/avr/lib",
    "--gc-sections",
    "{IN}",
    "{CORE_A}",
    "-lgcc",
    "-lm",
    "--start-group",
    "-lgcc",
    "-lm",
    "-lc",
    "-latmega328p",
    "--end-group"
  ]
}
