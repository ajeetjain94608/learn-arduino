{
  "name": "roboquest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "bake:env": "node tools/bake-env.mjs",
    "android:sync": "npm run build:device && npx cap sync android",
    "android:apk": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "build:device": "tsc -b && vite build --mode device",
    "bake:thumbs": "node tools/bake-thumbs.mjs",
    "avr:core": "node tools/avr/build-core.mjs && node tools/avr/record-commands.mjs",
    "avr:fixtures": "node tools/avr/build-fixtures.mjs",
    "avr:diagnostics": "node --experimental-strip-types tools/avr/build-fixtures.mjs --diagnostics",
    "avr:sysroot": "node --experimental-strip-types tools/avr-wasm/package-sysroot.mjs",
    "deploy:site": "npm run build && npx wrangler deploy"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@fontsource-variable/nunito": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "avr8js": "^0.21.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
